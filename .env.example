# All keys are optional. Without any key, REM still scans the website, tracking
# stack (incl. GTM containers), SEO/sitemaps, Wayback positioning history,
# App Store, and Hacker News — and gives you manual-check links for the rest.

# Unlocks ad libraries (Meta, Google, LinkedIn, Reddit), TikTok/IG/YouTube/X/
# LinkedIn/Threads stats, founder discovery and Reddit mentions.
# ~25–50 credits per full run. https://scrapecreators.com
SCRAPECREATORS_API_KEY=

# Unlocks the written strategy report (`rem <url>` without --no-llm).
# Not needed when you use REM through MCP — your agent writes the report.
ANTHROPIC_API_KEY=

# Optional overrides
# REM_MODEL=claude-opus-5
# REM_MAX_CREDITS=50
# REM_USER_AGENT=
